# Local dev (poetry run uvicorn ..., outside Docker) - real AWS access resolves the DB
# secret live via get_engine_quent(). Copy to .env and adjust.
CONFIG_PATH=./config.yaml
AWS_REGION=eu-central-1
# AWS_PROFILE=your-profile

# Docker deploy only (docker compose up) - the container has no AWS access, so the DB
# password comes from a materialized secret file instead (see
# scripts/materialize_runtime_secrets.py). host/user aren't secret - set them once here
# after running that script, which prints the current values.
# DB_HOST=
# DB_USER=

# Host port the dashboard is published on - defaults to 8080.
# DASHBOARD_PORT=8080
